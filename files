    <style>
        /* General Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Arial', sans-serif;
        }

        body {
            background-color: #121212;
            color: #fff;
            text-align: center;
        }

        /* Header Section */
        header {
            padding: 30px 20px;
            background: #1f1f1f;
            box-shadow: 0px 3px 10px rgba(255, 255, 255, 0.1);
        }

        header h1 {
            margin: 0;
            font-size: 2.5em;
        }

        header p {
            font-size: 1.2em;
            opacity: 0.8;
        }

        /* Projects Section */
        .projects-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            padding: 50px 10%;
        }

        /* Project Cards */
        .project-card {
            background:  #1e1e1e;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0px 4px 10px rgba(255, 255, 255, 0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            cursor: pointer;
        }

        .project-card:hover {
            transform: translateY(-5px);
            box-shadow: 0px 10px 20px rgba(255, 255, 255, 0.2);
        }

        .project-card i {
            font-size: 2.5em;
            color: #f39c12;
            margin-bottom: 10px;
        }

        .project-card h2 {
            margin: 10px 0;
            font-size: 1.5em;
        }

        .project-card p {
            font-size: 1em;
            opacity: 0.8;
            text-align: justify;
        }

        /* Buttons */
        .project-card a {
            display: inline-block;
            margin-top: 15px;
            padding: 10px 20px;
            color: #fff;
            background: #f39c12;
            border-radius: 5px;
            text-decoration: none;
            font-weight: bold;
            transition: background 0.3s;
        }

        .project-card a:hover {
            background: #d68910;
        }

        /* Footer 
        footer {
            background: #1f1f1f;
            padding: 15px;
            font-size: 0.9em;
            opacity: 0.7;
           
        }
        
        */
        
        
               /* Social media icons*/
        .social-media {
         margin-top: 10px;
         display: flex;
         justify-content: center;
         gap: 20px;
         }

        .social-media a {
         font-size: 24px;
         color: #fff;
         transition: transform 0.3s ease, color 0.3s ease;
         }

         .social-media a:hover {
          transform: scale(1.2);
          color: #ffcc00;
         } 

                /* Footer Styling */
        footer {
            background-color: #121212;
            color: #fff;
            padding: 20px;
            text-align: center;
            position: relative;
            bottom: 0;
            width: 100%;
        }

        footer p {
            margin: 10px 0;
        }

        footer a {
            color: #ffcc00;
            text-decoration: none;
            font-weight: 600;
        }

        footer a:hover {
            text-decoration: underline;
        }


        /* Style for the floating button */
        .floating-btn {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background-color: #f39c12;
            color: white;
            padding: 15px 20px;
            border-radius: 50px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
            font-size: 16px;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000; /* Ensure it floats on top of content */
        }

        /* Style for the link inside the button */
        #join-link {
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        #join-link:hover {
            text-decoration: underline;
        }

        /* Dismiss button inside the floating button */
        #dismiss-btn {
            margin-left: 10px;
            font-size: 20px;
            font-weight: bold;
            cursor: pointer;
            background:  #ff6666;
            border-radius: 50%;
            width: 25px;
            height: 25px;
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
            transition: background-color 0.3s ease;
        }

        #dismiss-btn:hover {
            color: #ff5c5c;
        }

    </style>
</head>



